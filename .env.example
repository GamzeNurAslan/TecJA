# TecJA PDF report email delivery
# Gmail example: host=smtp.gmail.com, port=587, TLS=true.
# Gmail accounts require an App Password, not the normal account password.
TECJA_SMTP_HOST=smtp.gmail.com
TECJA_SMTP_PORT=587
TECJA_SMTP_USERNAME=your-account@gmail.com
TECJA_SMTP_PASSWORD=your-app-password
TECJA_SMTP_FROM_EMAIL=your-account@gmail.com
TECJA_SMTP_FROM_NAME=TecJA Analytics
TECJA_SMTP_USE_TLS=true
TECJA_SMTP_USE_SSL=false
